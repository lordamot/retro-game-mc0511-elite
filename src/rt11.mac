; Native RT-11 startup and file-relative resource reads. Low memory and
; all CPU interrupt vectors belong to the monitor throughout play.
 .=1000
RT_ENTRY:
 MOV SP,RT_OLDSP
 .SETTO #MEM_TOP
 CMP R0,#MEM_TOP
 BLO RT_NOMEM
 MOV #PROG_SIZE,R1
 MOV #<STACK_TOP-PROG_SIZE>/2,R2
2$: MOV #125252,(R1)+
 SOB R2,2$
 MOV #STACK_TOP,SP
 .LOOKU #RT_AREA,#0,#RT_FILE
 BCS RT_NOFILE
 MOV R0,RT_BLOCKS
 .READW #RT_AREA,#0,#OVL_BASE,#256.,#0
 BCS RT_BADFILE
 MOV #RT_HEADER,R0
 MOV #OVL_BASE,R1
 MOV #16.,R2
1$: CMP (R0)+,(R1)+
 BNE RT_BADFILE
 SOB R2,1$
 MOV @#177560,RT_TTYCSR
 CLR @#177560
 TST @#177562
 JMP MAIN_START
RT_NOMEM:
 MOV #RT_MEMMSG,R4
 BR RT_REPORT
RT_NOFILE:
 MOV #RT_FILEMSG,R4
 BR RT_REPORT
RT_BADFILE:
 MOV #RT_DATMSG,R4
 BR RT_REPORT
RT_PPU_ERROR:
 MOV #RT_PPMSG,R4
 BR RT_CLEAN
RT_IOERROR:
 MOV #RT_IOMSG,R4
 BR RT_CLEAN
RT_EXIT:
 CLR R4
RT_CLEAN:
 MOV R4,RT_MESSAGE
 CALL PP_UNLOAD
 MOV RT_TTYCSR,@#177560
 MOV RT_MESSAGE,R4
RT_REPORT:
 .PURGE #0
 .PURGE #1
 MOV RT_OLDSP,SP
 TST R4
 BEQ 1$
 .PRINT R4
1$: MOV #-1,@#52
 .EXIT
RT_OLDSP: .WORD 0
RT_TTYCSR: .WORD 0
RT_MESSAGE: .WORD 0
RT_BLOCKS: .WORD 0
RT_FILE: .RAD50 /DK ELITE DAT/
RT_AREA: .BLKW 10
RT_MEMMSG: .ASCIZ /ELITE: insufficient memory; SET USR/EXIT SWAP/
RT_FILEMSG: .ASCIZ /ELITE: ELITE.DAT not found/
RT_DATMSG: .ASCIZ /ELITE: incompatible ELITE.DAT/
RT_PPMSG: .ASCIZ /ELITE: no PPU memory/
RT_IOMSG: .ASCIZ /ELITE: data read failed/
 .EVEN

; R0 = file-relative block, R1 = CPU buffer, R2 = words. C = error.
; All request state is resident; the overlay window may be swapped by USR.
DATA_READ:
 CMP R0,RT_BLOCKS
 BHIS 8$
 TST R2
 BEQ 8$
 CMP R2,#<OVL_END-OVL_BASE>/2
 BHI 8$
 CMP R1,#1000
 BLO 8$
 BIT #1,R1
 BNE 8$
 MOV R2,R3
 ADD #255.,R3
 ASH #-8.,R3
 ADD R0,R3
 BCS 8$
 CMP R3,RT_BLOCKS
 BHI 8$
 MOV R2,R3
 ASL R3
 ADD R1,R3
 BCS 8$
 CMP R3,#MEM_TOP
 BHI 8$
 MOV R0,RT_BLOCK
 MOV R1,RT_BUFFER
 MOV R2,RT_WORDS
 MOV #3,RT_TRIES
 CALL RING_WAIT
 INC RT_IOBUSY
1$: .READW #RT_AREA,#0,RT_BUFFER,RT_WORDS,RT_BLOCK
 BCC 9$
 DEC RT_TRIES
 BNE 1$
8$: SEC
9$: BIC #1,RT_IOBUSY ; preserve the read carry status
 RETURN
RT_BLOCK: .WORD 0
RT_BUFFER: .WORD 0
RT_WORDS: .WORD 0
RT_TRIES: .WORD 0
RT_IOBUSY: .WORD 0 ; PPU yields its longer tick work to firmware disk I/O
