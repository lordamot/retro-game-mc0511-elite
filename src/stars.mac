; Twelve distant points.  Private deterministic positions never consume
; the game's random stream.  Their six-byte vectors turn with the sky.
STAR_ON:	.WORD	1		; zero for geometry/performance comparisons
STAR_P:		.WORD	0
STAR_N:		.WORD	0
STAR_DATA:	.WORD	-4000.,1800.,8000., 2600.,-2200.,7000.
		.WORD	6000.,1000.,-6000., -5000.,-1000.,-4000.
		.WORD	8000.,2800.,2000., -8000.,-2400.,3000.
		.WORD	3000.,5500.,6000., -2000.,-6000.,7000.
		.WORD	-3000.,3000.,-7000., 4000.,-3400.,-8000.
		.WORD	7000.,-1800.,-3000., -6000.,4000.,1000.
STARS:		TST	STAR_ON
		BNE	1$
		RETURN
1$:		MOV	#STAR_DATA,STAR_P
		MOV	#12.,STAR_N
10$:		TST	PROLL
		BEQ	2$
		MOV	US_RS,RT_S
		MOV	US_RT,RT_T
		MOV	STAR_P,R5
		CLR	R1
		CALL	VEC_TURN_P
2$:		TST	PPITCH
		BEQ	3$
		MOV	US_PS,RT_S
		MOV	US_PT,RT_T
		MOV	STAR_P,R5
		MOV	#2,R1
		CALL	VEC_TURN_P
3$:		MOV	STAR_P,R4
		MOV	PSPEED,R0
		SUB	R0,4(R4)
		CMP	4(R4),#-12000.
		BGT	4$
		ADD	#24000.,4(R4)
4$:		MOV	(R4),R0
		MOV	2(R4),R1
		MOV	4(R4),R2
		MOV	VIEW_DIR,R3
		BEQ	6$
		CMP	R3,#VIEW_REAR
		BEQ	5$
		MOV	R0,R3
		MOV	R2,R0
		MOV	R3,R2
		CMP	VIEW_DIR,#VIEW_LEFT
		BEQ	51$
		NEG	R0
		BR	6$
51$:		NEG	R2
		BR	6$
5$:		NEG	R0
		NEG	R2
6$:		CALL	PROJECT
		BCS	8$
		MOV	PY,R0
		CMP	R0,#VIEW_H
		BHIS	8$
		ASL	R0
		MOV	SU_SPAN(R0),R0
		MOV	SU_OX,R1
		CALL	SUN_BOUNDS
		CMP	PX,R0
		BLT	7$
		CMP	PX,R1
		BLE	8$
7$:		MOV	PX,LX0
		MOV	PX,LX1
		MOV	PY,LY0
		MOV	PY,LY1
		CALL	SEG_LINE
8$:		ADD	#6,STAR_P
		DEC	STAR_N
		BEQ	9$
		JMP	10$
9$:		RETURN
