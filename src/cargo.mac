; =========================================================================
; cargo.mac - what a ship carries, and what it lets go.
;
; Two bytes of the original's blueprint header say it, and both were
; being read into SHIP_STATS and then ignored:
;
;   CARGO   top nibble = what the object is MADE of, one less than the
;           market index - an escape capsule is 2 (slaves), an alloy
;           plate 8 (metals), a splinter 11 (minerals), a Thargon 15
;           (alien items), and a plain canister 0, which is a mixed load
;           and is rolled when it is scooped;
;           bottom nibble = how many canisters it leaves when it breaks
;           up - three for a Cobra Mk III, five for a Python, seven for
;           a rock hermit, and none at all for a fighter, which is
;           exactly Elite's own split between traders and hunters.
;
;   LAUNCH  low three bits = how many ships it can put in the air: six
;           for a Thargoid, six for a Coriolis, two for a rock hermit.
;           What each one launches is not in the byte, so LAUNCH_TAB
;           below says: Thargons, Vipers, and - for the hermit - "any of
;           the original's fighters", which is how a rock turns out to
;           be a nest without this having to name a pirate.
;
; See docs/reference-sources.md for how the nibbles were pinned down: all
; four of the loot objects land on the market item every Elite gives
; them, which is four independent hits and not a guess.
; =========================================================================

DR_P:		.WORD	0		; the wreck being emptied
DR_N:		.WORD	0		; canisters still to leave
DR_WHAT:	.WORD	0		; and what they are
DR_MAX:		.WORD	0		; how many the sky will take
DR_DX:		.WORD	0		; and where this one goes
DR_DY:		.WORD	0
DR_DZ:		.WORD	0

; =========================================================================
; DROP_CARGO - R5 = the slot of something just destroyed.  Whatever it
; was carrying goes into the sky where it died.  Clobbers R0..R5.
; =========================================================================
DROP_CARGO:	CALL	U_NEAR			; a wreck beyond sixteen bits
		BCC	.+4			;   drops nothing anyone will see
		RETURN
		MOV	R5,DR_P
		MOV	#SH_CANISTER,DR_WHAT
		MOV	U.TYPE(R5),R0
		CMP	R0,#SH_ASTEROID		; a rock breaks into splinters,
		BEQ	1$			; not into cargo
		MOV	#SS_CARGO,R1
		CALL	SHIP_STAT
		BIC	#177760,R0		; the bottom nibble is the count
		MOV	R0,DR_N
		BR	2$
1$:		MOV	#SH_SPLINTER,DR_WHAT
		CALL	RND_BYTE
		BIC	#177774,R0		; one to four splinters, of which
		INC	R0			; the cap below ever reach the sky
		MOV	R0,DR_N
2$:		TST	DR_N
		BEQ	9$
		MOV	#DROP_MAX,DR_MAX	; a mining laser is worth twice as
		CMP	LAST_WEAPON,#LAS_MINING	; much rock, which is the whole
		BNE	21$			; reason to carry one
		ASL	DR_MAX
21$:		CMP	DR_N,DR_MAX
		BLE	3$
		MOV	DR_MAX,DR_N
		; Where each one goes.  Two canisters left in the same place
		; are inside each other's collision distance and break up on
		; the spot, so the spread is worked out rather than rolled:
		; alternate sides by the count still to drop, a step back
		; along z per canister, and a little jitter on top so a
		; wreck's cargo does not look stamped out.
3$:		MOV	#96.,DR_DX
		MOV	#64.,DR_DY
		BIT	#1,DR_N
		BNE	31$
		NEG	DR_DX
		NEG	DR_DY
31$:		CALL	RND_BYTE
		SUB	#128.,R0
		ASR	R0			; -64..63
		ASR	R0
		ADD	R0,DR_DX
		MOV	DR_N,R0
		MUL	#40.,R0			; R0 even, but the product is small
		MOV	R1,DR_DZ
		MOV	DR_P,R5
		MOV	U.X(R5),R1
		ADD	DR_DX,R1
		MOV	U.Y(R5),R2
		ADD	DR_DY,R2
		MOV	U.Z(R5),R3
		ADD	DR_DZ,R3
		MOV	DR_WHAT,R0
		CLR	R4			; it hangs where the ship died
		CALL	UNIV_ADD
		BCS	9$			; the sky is full: the rest is lost
		DEC	DR_N
		BGT	3$
9$:		RETURN

; =========================================================================
; SCOOP_STEP - take aboard anything small that the commander flies into.
;
; Elite sells a fuel scoop for this and charges you for arriving without
; one: cargo you cannot catch hits the hull instead, and the shields pay
; for it.  Called once a flight frame.
; =========================================================================
SC_P:		.WORD	0
SC_I:		.WORD	0
SC_GOOD:	.WORD	0		; the market index of what was caught

SCOOP_STEP:	MOV	#UNIV,SC_P
		MOV	#NUNIV,SC_I
10$:		MOV	SC_P,R5
		CALL	U_NEAR
		BCS	80$
		MOV	U.TYPE(R5),R0
		BEQ	80$
		TST	U.EXPL(R5)		; something burning is not cargo
		BNE	80$
		BIT	#UF_DROP,U.FLAGS(R5)	; only a container (a rock is not)
		BEQ	80$
		MOV	U.Z(R5),R0		; dead ahead, and close
		BLE	80$
		CMP	R0,#SCOOP_Z
		BGT	80$
		MOV	U.X(R5),R0
		BGE	11$
		NEG	R0
11$:		CMP	R0,#SCOOP_XY
		BGT	80$
		MOV	U.Y(R5),R0
		BGE	12$
		NEG	R0
12$:		CMP	R0,#SCOOP_XY
		BGT	80$

		BITB	#DEV_OFF,P_FUELSCOOPS	; nothing fitted to catch it with:
		BEQ	20$			; it comes off the forward shield,
		MOV	U.TYPE(R5),R0		;   the canister's own collision
		MOV	#SS_COLLIDE,R1		;   byte of a blow
		CALL	SHIP_STAT
		MOV	SC_P,R5
		CLR	U.TYPE(R5)
		MOV	R0,-(SP)
		MOV	#FX_BUMP,R0
		CALL	SFX_PLAY
		MOV	(SP)+,R0
		CLR	R1
		CALL	HIT_PLAYER
		BR	80$
20$:		CALL	SCOOP_TAKE
80$:		ADD	#U.SIZE,SC_P
		DEC	SC_I
		BGT	10$
		RETURN

; =========================================================================
; The auto-take (Legend's Autotake Cargo Device, MissileFire's goto736):
; with "8" on MF_TAKE, the space bar marks the LOCKED drop as taken and
; it flies to you the way a missile with your name on it does - Legend
; sets the missile bit and points it at the player - until the scoop's
; box has it, where SCOOP_STEP takes it aboard, or bounces it off the
; hull if there are no scoops, exactly as it would any drop.
; =========================================================================
TK_I:		.WORD	0

; TAKE_LOCK - the lock is on a drop: mark it; on anything else the till
; buzzes.  Clobbers R0, R1, R5.
TAKE_LOCK:	MOV	MISS_LOCK,R5
		CLR	MISS_LOCK
		DEC	R5
		MUL	#U.SIZE,R5		; R5 is ODD: the low word
		ADD	#UNIV,R5
		MOV	U.TYPE(R5),R0
		BEQ	8$
		BIT	#UF_DROP,U.FLAGS(R5)	; a rock is not a drop
		BEQ	8$
		BIS	#UF_TAKEN,U.FLAGS(R5)
		MOV	#FX_CARGO,R0		; CaptureCargo
		JMP	SFX_PLAY
8$:		MOV	#FX_KEY,R0
		JMP	SFX_PLAY

; TAKE_STEP - once a frame: every taken drop an eighth of the way onto
; your line and TAKE_SPEED nearer, to TAKE_Z ahead.  Clobbers R0, R5.
TAKE_STEP:	MOV	#UNIV,R5
		MOV	#NUNIV,TK_I
1$:		TST	U.TYPE(R5)
		BEQ	8$
		BIT	#UF_TAKEN,U.FLAGS(R5)
		BEQ	8$
		TST	U.EXPL(R5)
		BNE	8$
		CALL	U_NEAR			; beyond sixteen bits it waits
		BCS	8$
		MOV	U.X(R5),R0
		ASH	#-3,R0
		SUB	R0,U.X(R5)
		MOV	U.Y(R5),R0
		ASH	#-3,R0
		SUB	R0,U.Y(R5)
		MOV	U.Z(R5),R0
		SUB	#TAKE_Z,R0		; how far from the box
		BGE	2$
		NEG	R0
		CMP	R0,#TAKE_SPEED
		BLO	3$
		ADD	#TAKE_SPEED,U.Z(R5)
		BR	4$
2$:		CMP	R0,#TAKE_SPEED
		BLO	3$
		SUB	#TAKE_SPEED,U.Z(R5)
		BR	4$
3$:		MOV	#TAKE_Z,U.Z(R5)		; within a step: in the box
4$:		CLR	U.SPEED(R5)		; it goes where it is steered
		CALL	U_SXT
8$:		ADD	#U.SIZE,R5
		DEC	TK_I
		BGT	1$
		RETURN

; TANK_FILL - the space bar with "8" on MF_TANK (goto569): the extra
; tank's tenths into the main one, as many as it is short, and the word
; Legend prints for it.  Clobbers R0..R5.
TANK_FILL:	MOV	CKV_MAXFUEL,R2
		SUB	PFUEL,R2		; what the main tank is short
		BLE	9$
		MOVB	P_TANKS,R0
		BMI	9$			; no tank
		MOV	R0,R1
		BIC	#177700,R1		; what is in it
		BIC	#77,R0			; and the byte without it
		SUB	R2,R1
		BGE	1$
		ADD	R1,R2			; not enough: all of it
		CLR	R1
1$:		BIS	R1,R0
		MOVB	R0,P_TANKS
		ADD	R2,PFUEL
		MOV	#S_M_REFUEL,R1
		CALL	SAY_LINE
		MOV	#FX_REFUEL,R0		; Refueled
		JMP	SFX_PLAY
9$:		RETURN

; =========================================================================
; SCOOP_TAKE - R5 = the slot of a drop the scoop has caught.
; =========================================================================
SCOOP_TAKE:	BIT	#UF_ALIENITEM,U.FLAGS(R5)
		BEQ	10$
		MOV	#G_ALIEN,R0
		BR	2$
10$:		CALL	MS_SCOOP		; a mission's container?
		BCC	5$
		RETURN
5$:		TST	R0			; or a tonne of computers
		BGE	2$
		MOV	U.TYPE(R5),R0		; what is it made of?
		MOV	#SS_CARGO,R1
		CALL	SHIP_STAT
		ASH	#-4,R0			; the top nibble, one less than
		BEQ	1$			; the market index
		INC	R0
		BR	2$
1$:		MOV	R5,-(SP)		; a plain canister: anything at all
		CALL	RND_BYTE		; might be inside it
		CLR	R2			; DIV wants an even register
		MOV	R0,R3
		DIV	#NGOODS,R2		; R3 = the remainder
		MOV	R3,R0
		MOV	(SP)+,R5
2$:		MOV	R0,SC_GOOD

		MOV	R0,R1			; does it need room in the hold?
		MUL	#G.SIZE,R1		; R1 is ODD, so the low word is the
		ADD	#GOODS,R1		; whole product
		MOVB	G.UNIT(R1),R0
		BNE	3$			; kilogrammes and grammes ride free
		TST	P_FREECARGO		; room for a tonne?
		BLE	4$
		DEC	P_FREECARGO
		BR	3$
4$:		CLR	U.TYPE(R5)		; full: it bounces off and is lost
		MOV	#FX_KEY,R0
		JMP	SFX_PLAY

3$:		CLR	U.TYPE(R5)
		MOV	SC_GOOD,R0
		ASL	R0
		INC	CARGO(R0)
		MOV	#FX_CARGO,R0
		CALL	SFX_PLAY
		MOV	#2,TX			; say what it was; the flight loop
		MOV	#4,TY			; wipes the line again
		MOV	SC_GOOD,R0
		ASL	R0
		MOV	GOODNAMES(R0),R1
		CALL	PUTS2
		MOV	#40.,HYP_SHOW
		RETURN

; =========================================================================
; SUN_SCOOP - the other half of what a fuel scoop is for.
;
; Elite fills the tanks off a star's corona and charges for the
; privilege: the cabin heats as you close, and if the gauge ever reaches
; the top the ship is gone.  This port had a cabin temperature gauge
; showing a constant 30 since the dashboard was written; now it reads
; the sun.
;
; The distance is |P| squared in the same BODY_QSH units BODY_CHECK
; uses, which keeps the three squares well inside 32 bits and costs
; three multiplies a frame.
; =========================================================================
SS_D2:		.WORD	0		; how far off the sun is, squared

SUN_SCOOP:	MOV	#UNIV,R5
		MOV	#NUNIV,R4
1$:		TST	U.TYPE(R5)
		BEQ	2$
		BIT	#UF_SUN,U.FLAGS(R5)
		BNE	3$
2$:		ADD	#U.SIZE,R5
		DEC	R4
		BGT	1$
		BR	70$			; no sun here: the cabin cools

3$:		CALL	U_NEAR			; a sun beyond sixteen bits is far
		BCS	70$			;   enough to be cold
		CLR	ACCH
		CLR	ACCL
		MOV	U.X(R5),R2
		ASH	#BODY_QSH,R2
		MOV	R2,R3
		MUL	R3,R2			; R2 is EVEN, so the 32 bits land
		ADD	R3,ACCL			; in R2:R3
		ADC	ACCH
		ADD	R2,ACCH
		MOV	U.Y(R5),R2
		ASH	#BODY_QSH,R2
		MOV	R2,R3
		MUL	R3,R2
		ADD	R3,ACCL
		ADC	ACCH
		ADD	R2,ACCH
		MOV	U.Z(R5),R2
		ASH	#BODY_QSH,R2
		MOV	R2,R3
		MUL	R3,R2
		ADD	R3,ACCL
		ADC	ACCH
		ADD	R2,ACCH

		TST	ACCH			; anything in the high word is a
		BNE	70$			; long way outside
		MOV	ACCL,SS_D2
		CMP	SS_D2,#SUN_HOT2
		BHIS	70$			; far enough to stay comfortable

		MOV	#SUN_HOT2,R0		; the gauge, linear in d^2
		SUB	SS_D2,R0
		CLR	R1
		MOV	R0,R1			; DIV takes R0:R1 and wants an even
		CLR	R0			; register
		DIV	#SUN_TSPAN,R0
		ADD	#CAB_COOL,R0
		CMP	R0,#CAB_MAX
		BLO	4$
		MOV	#CAB_MAX,R0
4$:		MOV	R0,PCABTEMP
		CMP	R0,#CAB_MAX		; the cabin cannot take any more
		BLO	5$
		JMP	PLAYER_DEAD		; the cabin cooked

5$:		BITB	#DEV_OFF,P_FUELSCOOPS	; the tanks fill only if there is
		BNE	9$			; something to fill them with
		CMP	PFUEL,CKV_MAXFUEL	; the tank is the ship's
		BHIS	9$
		MOV	FLY_TICK,R0
		BIC	#177774,R0		; one tenth every fourth frame
		BNE	9$
		INC	PFUEL
		CMP	PFUEL,CKV_MAXFUEL
		BLO	9$
		MOV	#FX_KEY,R0		; and a beep when it is full
		JMP	SFX_PLAY
9$:		RETURN

70$:		MOV	PCABTEMP,R0		; nothing warm nearby: the cabin
		CMP	R0,#CAB_COOL		; comes back down at its own pace
		BLOS	9$
		SUB	#CAB_FALL,R0
		CMP	R0,#CAB_COOL
		BHIS	71$
		MOV	#CAB_COOL,R0
71$:		MOV	R0,PCABTEMP
		RETURN
